parameters:
  level: 5

  paths:
    - web/modules/custom
    - web/themes/custom
    - web/profiles/custom

  excludePaths:
    - web/core
    - web/modules/contrib
    - web/themes/contrib (?)
    - web/profiles/contrib (?)
    - vendor

  # PHPStan 2 and the Drupal/PHPUnit extensions can prove some runtime guards
  # from service metadata and PHPDoc alone. Keep those guards/assertions because
  # they still protect real runtime behaviour, but scope the exceptions narrowly.
  ignoreErrors:
    -
      identifiers:
        - staticMethod.alreadyNarrowedType
        - instanceof.alwaysTrue
        - dependencySerializationTraitProperty.unsupportedPrivateProperty
      path: web/modules/custom/*/tests/*
      reportUnmatched: false
    -
      identifier: function.alreadyNarrowedType
      paths:
        - web/modules/custom/emerging_digital_chatbot/src/Context/PublicContextBuilder.php
        - web/modules/custom/emerging_digital_chatbot/src/QualificationEngine.php
      reportUnmatched: false
    -
      identifier: instanceof.alwaysTrue
      paths:
        - web/modules/custom/agency_content_seed/agency_content_seed.post_update.php
        - web/modules/custom/emerging_digital_chatbot/src/Context/PublicContextBuilder.php
        - web/modules/custom/emerging_digital_content/src/ContentSync/ContentSyncManager.php
      reportUnmatched: false
    -
      identifier: nullCoalesce.offset
      paths:
        - web/modules/custom/emerging_digital_content/emerging_digital_content.post_update.php
        - web/modules/custom/emerging_digital_content/src/ContentSync/ContentSyncManager.php
        - web/themes/custom/emerging_digital/emerging_digital.theme
      reportUnmatched: false
