parameters:
  level: 5

  paths:
    - web/modules/custom
    - web/themes/custom
    - web/profiles/custom

  excludePaths:
    - web/core
    - web/modules/contrib
    - web/themes/contrib (?)
    - web/profiles/contrib (?)
    - vendor

  # PHPStan 2 and the Drupal/PHPUnit extensions can prove some runtime guards
  # from service metadata and PHPDoc alone. Keep those test assertions because
  # they still protect real runtime behaviour.
  ignoreErrors:
    -
      identifiers:
        - staticMethod.alreadyNarrowedType
        - instanceof.alwaysTrue
      path: web/modules/custom/*/tests/*
      reportUnmatched: false
    -
      # Configuration arrays can still contain numeric keys at runtime. Keep the
      # defensive is_string() guard even though the method PHPDoc promises strings.
      identifier: function.alreadyNarrowedType
      path: web/modules/custom/emerging_digital_chatbot/src/QualificationEngine.php
      reportUnmatched: false
