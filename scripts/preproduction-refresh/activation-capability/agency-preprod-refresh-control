class ContractError(RuntimeError):
    """Fail-closed fixed capability contract violation."""


def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def require_fixed_file(path: str, digest: str | None, mode: int) -> os.stat_result:
    try:
        meta = os.lstat(path)
    except FileNotFoundError as exc:
        raise ContractError("Required fixed root-owned file is absent.") from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode) or meta.st_nlink != 1:
        raise ContractError("Required fixed file type/link count invalid.")
    if meta.st_uid != 0 or meta.st_gid != 0 or stat.S_IMODE(meta.st_mode) != mode:
        raise ContractError("Required fixed file ownership/mode invalid.")
    if digest is not None and sha256_file(path) != digest:
        raise ContractError("Required fixed file digest mismatch.")
    return meta


def require_fixed_dir(path: str, mode: int) -> None:
    try:
        meta = os.lstat(path)
    except FileNotFoundError as exc:
        raise ContractError("Required fixed directory is absent.") from exc
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISDIR(meta.st_mode):
        raise ContractError("Required fixed directory type invalid.")
    if meta.st_uid != 0 or meta.st_gid != 0 or stat.S_IMODE(meta.st_mode) != mode:
        raise ContractError("Required fixed directory ownership/mode invalid.")


def load_python_module(path: str, digest: str, name: str) -> ModuleType:
    require_fixed_file(path, digest, 0o644)
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise ContractError("Pinned module loader unavailable.")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def load_contract() -> ModuleType:
    return load_python_module(CONTRACT_PATH, CONTRACT_SHA256, "agency_preprod_transaction_contract")


def load_json_fixed(path: str, digest: str, mode: int) -> dict[str, Any]:
    require_fixed_file(path, digest, mode)
    try:
        value = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ContractError("Fixed JSON cannot be loaded.") from exc
    if not isinstance(value, dict):
        raise ContractError("Fixed JSON must be an object.")
    return value


def load_canonical_sanitizer() -> tuple[ModuleType, dict[str, Any]]:
    sanitizer = load_python_module(SANITIZER_PATH, SANITIZER_SHA256, "agency_preprod_staging_sanitizer")
    policy = load_json_fixed(POLICY_PATH, POLICY_SHA256, 0o644)
    try:
        sanitizer.validate_policy(policy)
    except Exception as exc:
        raise ContractError("Canonical agency-preprod-refresh-v1 policy rejected.") from exc
    return sanitizer, policy


def load_refresh_modules() -> tuple[ModuleType, ModuleType]:
