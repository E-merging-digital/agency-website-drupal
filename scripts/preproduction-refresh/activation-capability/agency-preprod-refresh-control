def verify_runtime_admin_identity() -> None:
    current = os.path.realpath(CURRENT_LINK)
    drush = current + "/vendor/bin/drush"
    code = r'''$u=user_load_by_name("preprod-admin"); if (!$u || !$u->isActive() || !$u->hasRole("administrator")) { throw new \\RuntimeException("fixed preprod admin missing"); }'''
