def drop_schema_if_present(database: str) -> None:
    if schema_exists(database):
        root_sql(f"DROP DATABASE {quote_identifier(database)}")


def cleanup_transaction_databases(paths: dict[str, str]) -> None:
    for key in ("staging_db", "candidate_db", "rollback_db"):
        drop_schema_if_present(paths[key])


def rollback_transaction(contract: ModuleType, authority: dict[str, Any], paths: dict[str, str]) -> None:
    _, state_digest = load_refresh_modules()
    authority = load_active(contract)
    if authority["terminal"]:
        raise ContractError("Terminal authority cannot be reused for rollback.")
    phase = authority["phase"]
    pre_sha = authority.get("preactivation_runtime_sha256")
    release_sha = authority.get("application_release_sha256")
    backup_sha = authority.get("backup_sha256")
    authority = update_active(contract, authority, state=contract.STATE_IN_PROGRESS, phase=contract.PHASE_ROLLBACK_STARTED)
    require_fence_closed()
    try:
        if not isinstance(pre_sha, str) or not isinstance(release_sha, str):
            raise ContractError("Recorded preactivation recovery identity unavailable.")
        strategy = contract.rollback_strategy(phase)
        if strategy == "VERIFY_UNCHANGED_OR_EXACT_BACKUP":
            current_sha = state_digest.runtime_state_sha256()
            if current_sha != pre_sha:
                if not isinstance(backup_sha, str):
                    raise ContractError("Pre-swap runtime changed without verified backup.")
                state_digest.restore_verified_backup(paths["backup"], backup_sha)
        elif strategy == "REVERSE_ATOMIC_SWAP_THEN_EXACT_BACKUP_FALLBACK":
            try:
                reverse_atomic_swap(paths)
            except Exception:
                if not isinstance(backup_sha, str):
                    raise
                state_digest.restore_verified_backup(paths["backup"], backup_sha)
        elif strategy == "EXACT_PREACTIVATION_BACKUP":
            if not isinstance(backup_sha, str):
                raise ContractError("Post-convergence rollback requires verified backup.")
            state_digest.restore_verified_backup(paths["backup"], backup_sha)
        else:
            raise ContractError("Unknown fixed rollback strategy.")

        if state_digest.runtime_state_sha256() != pre_sha:
            raise ContractError("Rollback previous runtime digest verification failed.")
        if application_release_identity_sha256() != release_sha:
            raise ContractError("Rollback application release identity changed.")
        validate_runtime_invariants()
        verify_runtime_admin_identity()
        cleanup_transaction_databases(paths)
        safe_unlink(paths["seal"])
        safe_unlink(paths["snapshot"])
        safe_unlink(paths["manifest"])
        open_fence_after_terminal_proof()
        terminalize(contract, authority, contract.STATE_ROLLED_BACK)
        print("ROLLBACK_RECORDED=PASS")
        print("PREVIOUS_RUNTIME_DIGEST=RESTORED")
        print("RELEASE_UNCHANGED=PASS")
        print("FENCE_REOPEN_ONLY_AFTER_PROOF=PASS")
        print("HUMAN_RECOVERY_REQUIRED=false")
    except BaseException as exc:
        try:
            failed = update_active(
                contract,
                authority,
                state=contract.STATE_FAILED_RECOVERY,
                phase=contract.PHASE_TERMINAL,
                terminal=True,
                human_recovery_required=True,
            )
        except Exception:
            failed = authority
        record_recovery_metadata(failed, paths, "ROLLBACK_VERIFY_FAILED")
        print("ROLLBACK_VERIFY_FAILURE=FENCE_CLOSED", file=sys.stderr)
        print("HUMAN_RECOVERY_REQUIRED=true", file=sys.stderr)
        raise ContractError("Rollback failed closed; fence remains closed and recovery identity retained.") from exc


def action_activate(contract: ModuleType, authority: dict[str, Any]) -> None:
    paths = derived_paths(contract, authority)
    require_candidate_seal(authority, paths)
    _, state_digest = load_refresh_modules()
    outer = acquire_lock(OUTER_DEPLOY_LOCK, create=False)
    refresh = acquire_lock(REFRESH_LOCK, create=True)
    pre_sha: str | None = None
    release_sha: str | None = None
    try:
        pre_sha = state_digest.runtime_state_sha256()
        release_sha = application_release_identity_sha256()
        close_fence()
        authority = update_active(
            contract,
            authority,
            state=contract.STATE_IN_PROGRESS,
            phase=contract.PHASE_FENCE_CLOSED,
            preactivation_runtime_sha256=pre_sha,
            application_release_sha256=release_sha,
        )
        drain_runtime_sessions()
        if application_release_identity_sha256() != release_sha:
            raise ContractError("Application release changed inside closed fence.")
        require_fixed_dir(BACKUP_DIR, 0o700)
        backup_sha, backup_bytes = state_digest.write_verified_backup(paths["backup"])
        if state_digest.runtime_state_sha256() != pre_sha:
            raise ContractError("Deterministic backup repeatability proof failed.")
        authority = update_active(
            contract,
            authority,
            phase=contract.PHASE_BACKUP_VERIFIED,
            backup_sha256=backup_sha,
            backup_bytes=backup_bytes,
        )
        candidate_tables = base_tables(paths["candidate_db"])
        runtime_tables = base_tables(RUNTIME_DB)
        authority = update_active(contract, authority, phase=contract.PHASE_SWAP_ATTEMPTED)
        atomic_swap(paths, candidate_tables, runtime_tables)
        authority = update_active(contract, authority, phase=contract.PHASE_SWAPPED)
        authority = run_fixed_drupal_convergence(contract, authority)
        validate_runtime_invariants()
        verify_runtime_admin_identity()
        if application_release_identity_sha256() != release_sha:
            raise ContractError("Application release changed during refresh transaction.")
        authority = update_active(contract, authority, phase=contract.PHASE_RUNTIME_VALIDATED)
        cleanup_transaction_databases(paths)
        safe_unlink(paths["seal"])
        safe_unlink(paths["snapshot"])
        safe_unlink(paths["manifest"])
        open_fence_after_terminal_proof()
        terminalize(contract, authority, contract.STATE_COMMITTED)
        print("BACKUP_ACTIVATE_CONVERGE_VALIDATE=PASS")
        print("PREPROD_ADMIN_RECONCILIATION=PASS")
        print("APPLICATION_RELEASE_CHANGE=NONE")
        print("GOVERNED_CONTENT_APPLY=FORBIDDEN_NOT_PERFORMED")
        print("FENCE_REOPEN_ONLY_AFTER_PROOF=PASS")
    except BaseException as exc:
        try:
            active = load_active(contract)
            if os.path.lexists(FENCE_MARKER) and active["phase"] in {
                contract.PHASE_FENCE_CLOSED, contract.PHASE_BACKUP_VERIFIED,
                contract.PHASE_SWAP_ATTEMPTED, contract.PHASE_SWAPPED,
                contract.PHASE_CONVERGENCE_STARTED, contract.PHASE_RUNTIME_VALIDATED,
                contract.PHASE_ROLLBACK_STARTED,
            }:
                rollback_transaction(contract, active, paths)
            else:
                # Failure before the transaction fence/swap: no runtime mutation
                # authority was exercised. Prove unchanged before terminal reuse.
                if pre_sha is None or release_sha is None:
                    raise ContractError("Pre-fence runtime identity was not captured.")
                if state_digest.runtime_state_sha256() != pre_sha:
                    raise ContractError("Pre-fence failure changed runtime unexpectedly.")
                if application_release_identity_sha256() != release_sha:
                    raise ContractError("Pre-fence failure changed application release.")
                cleanup_transaction_databases(paths)
                safe_unlink(paths["seal"])
                terminalize(contract, active, contract.STATE_ROLLED_BACK)
        except Exception as rollback_exc:
            raise ContractError("Activation failed and terminal rollback did not complete.") from rollback_exc
        raise ContractError("Activation transaction failed; exact previous runtime restored or unchanged proven.") from exc
    finally:
        refresh.close()
        outer.close()


def action_rollback(contract: ModuleType, authority: dict[str, Any]) -> None:
    paths = derived_paths(contract, authority)
    outer = acquire_lock(OUTER_DEPLOY_LOCK, create=False)
    refresh = acquire_lock(REFRESH_LOCK, create=True)
    try:
        rollback_transaction(contract, authority, paths)
    finally:
        refresh.close()
        outer.close()


def dispatch(contract: ModuleType, operation: dict[str, Any]) -> None:
    authority = load_active(contract)
    try:
        contract.validate_operation_binding(authority, operation)
    except Exception as exc:
        raise ContractError("Transaction authority/action/phase binding rejected.") from exc
    if operation["action"] == contract.IMPORT:
        action_import(contract, authority)
        return
    if operation["action"] == contract.ACTIVATE:
        action_activate(contract, authority)
        return
    if operation["action"] == contract.ROLLBACK:
        action_rollback(contract, authority)
        return
    raise ContractError("Invalid fixed action dispatch.")


def main() -> int:
    if os.geteuid() != 0:
        raise ContractError("Privileged helper must execute as root.")
    for path, mode in (
        (STATE_DIR, 0o711), (AUTHORITY_DIR, 0o700), (HISTORY_DIR, 0o700),
        (RECOVERY_DIR, 0o700), (INCOMING_DIR, 0o700), (CANDIDATE_DIR, 0o700),
        (BACKUP_DIR, 0o700),
    ):
        require_fixed_dir(path, mode)
    contract = load_contract()
    operation = parse_operation(contract)
    # Serialize helper state transitions with ingress/authority installation.
    authority_lock = acquire_lock(AUTHORITY_LOCK, create=True)
    try:
        dispatch(contract, operation)
    finally:
        authority_lock.close()
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ContractError, OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(80)
