def atomic_json_replace(path: str, value: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    tmp = parent + "/.state." + str(os.getpid()) + ".tmp"
    raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, 0o600)
    try:
        os.write(fd, raw)
        os.fsync(fd)
    finally:
        os.close(fd)
    require_fixed_file(tmp, None, 0o600)
    os.replace(tmp, path)
    dirfd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)
    require_fixed_file(path, None, 0o600)


def write_json_exclusive(path: str, value: dict[str, Any]) -> None:
    raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        os.write(fd, raw)
        os.fsync(fd)
    finally:
        os.close(fd)
    require_fixed_file(path, None, 0o600)


def load_active(contract: ModuleType) -> dict[str, Any]:
    require_fixed_dir(AUTHORITY_DIR, 0o700)
    require_fixed_file(ACTIVE_AUTHORITY, None, 0o600)
    try:
        value = json.loads(Path(ACTIVE_AUTHORITY).read_text(encoding="utf-8"))
        return contract.validate_authority_state(value)
    except Exception as exc:
        raise ContractError("Active transaction authority invalid/corrupt.") from exc


def update_active(contract: ModuleType, authority: dict[str, Any], **changes: Any) -> dict[str, Any]:
    current = load_active(contract)
    if current["authority_id"] != authority["authority_id"]:
        raise ContractError("Active transaction hijack/collision detected.")
    updated = dict(current)
    updated.update(changes)
    try:
        updated = contract.validate_authority_state(updated)
    except Exception as exc:
        raise ContractError("Refused invalid transaction state transition.") from exc
    atomic_json_replace(ACTIVE_AUTHORITY, updated)
    return updated


def terminalize(contract: ModuleType, authority: dict[str, Any], state_name: str, human: bool = False) -> dict[str, Any]:
    updated = update_active(
        contract,
        authority,
        state=state_name,
        phase=contract.PHASE_TERMINAL,
        terminal=True,
        human_recovery_required=human,
    )
    if state_name == contract.STATE_FAILED_RECOVERY:
        return updated
    history_path = HISTORY_DIR + "/" + updated["authority_id"] + ".json"
    require_fixed_dir(HISTORY_DIR, 0o700)
    write_json_exclusive(history_path, updated)
    os.unlink(ACTIVE_AUTHORITY)
    return updated


def parse_operation(contract: ModuleType) -> dict[str, Any]:
    if len(sys.argv) != 1:
        raise ContractError("Helper accepts no command-line arguments; structured stdin only.")
    raw = sys.stdin.buffer.read(8193)
    if len(raw) > 8192:
        raise ContractError("Operation input exceeds fixed bound.")
    try:
        payload = json.loads(raw.decode("utf-8"))
        return contract.parse_operation(payload)
    except Exception as exc:
        raise ContractError("Operation input rejected.") from exc


def root_sql(query: str) -> str:
    result = subprocess.run(
        [MARIADB_BIN, "--protocol=socket", "--batch", "--skip-column-names", "--raw"],
        input=query + "\n",
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
        env=CLEAN_ENV,
    )
    if result.returncode != 0:
        raise ContractError("Fixed MariaDB operation failed.")
    return result.stdout.strip()


def quote_identifier(value: str) -> str:
    if value == RUNTIME_DB or SAFE_DB_RE.fullmatch(value) or SAFE_TABLE_RE.fullmatch(value):
        return "`" + value + "`"
    raise ContractError("Unsafe internally-derived identifier.")


def schema_exists(database: str) -> bool:
    value = root_sql(
        "SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME="
        + "CONVERT(0x" + database.encode().hex() + " USING utf8mb4)"
    )
    return value == "1"


def require_schema_absent(database: str) -> None:
    if schema_exists(database):
        raise ContractError("Derived transient database unexpectedly exists.")


def information_schema_count(database: str, object_name: str) -> int:
    dbhex = database.encode().hex()
    queries = {
        "views": "SELECT COUNT(*) FROM information_schema.VIEWS WHERE TABLE_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex,
        "triggers": "SELECT COUNT(*) FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex,
        "events": "SELECT COUNT(*) FROM information_schema.EVENTS WHERE EVENT_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex,
        "routines": "SELECT COUNT(*) FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex,
        "foreign_keys": "SELECT COUNT(*) FROM information_schema.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex,
    }
    value = root_sql(queries[object_name])
    if not re.fullmatch(r"[0-9]+", value):
        raise ContractError("MariaDB object-count proof invalid.")
    return int(value)


def base_tables(database: str) -> list[str]:
    dbhex = database.encode().hex()
    output = root_sql(
        "SELECT TABLE_NAME FROM information_schema.TABLES "
        "WHERE TABLE_SCHEMA=CONVERT(0x%s USING utf8mb4) AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME" % dbhex
    )
    names = [line for line in output.splitlines() if line]
    if not names:
        raise ContractError("Activation subset contains no base tables.")
    for name in names:
        if not SAFE_TABLE_RE.fullmatch(name):
            raise ContractError("Invalid table identity in activation subset.")
    total = root_sql(
        "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=CONVERT(0x%s USING utf8mb4)" % dbhex
    )
    if not re.fullmatch(r"[0-9]+", total) or int(total) != len(names):
        raise ContractError("Unsupported non-base table object present.")
    for kind in ("views", "triggers", "events", "routines", "foreign_keys"):
        if information_schema_count(database, kind) != 0:
            raise ContractError(f"Unsupported MariaDB object present: {kind}")
    return names


def derived_paths(contract: ModuleType, authority: dict[str, Any]) -> dict[str, str]:
    staging, candidate, rollback = contract.derived_db_names(authority)
    return {
        "staging_db": staging,
        "candidate_db": candidate,
        "rollback_db": rollback,
        "snapshot": INCOMING_DIR + "/" + contract.spool_basename(authority),
        "manifest": INCOMING_DIR + "/" + contract.manifest_basename(authority),
        "seal": CANDIDATE_DIR + "/" + authority["authority_id"] + ".json",
        "backup": BACKUP_DIR + "/" + authority["authority_id"] + ".sql",
        "recovery": RECOVERY_DIR + "/" + authority["authority_id"] + ".json",
    }


def require_bound_spool(contract: ModuleType, authority: dict[str, Any], paths: dict[str, str]) -> None:
    require_fixed_dir(INCOMING_DIR, 0o700)
    snapshot_meta = require_fixed_file(paths["snapshot"], None, 0o600)
    require_fixed_file(paths["manifest"], None, 0o600)
    if snapshot_meta.st_size != authority["snapshot_bytes"]:
        raise ContractError("Bound spool byte count mismatch.")
    if sha256_file(paths["snapshot"]) != authority["snapshot_sha256"]:
        raise ContractError("Bound spool SHA-256 mismatch.")
    try:
        manifest = json.loads(Path(paths["manifest"]).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ContractError("Bound spool manifest invalid.") from exc
    expected = {
        "schema_version": 1,
        "authority_id": authority["authority_id"],
        "successor_issue": authority["successor_issue"],
        "request_id": authority["request_id"],
        "main_sha": authority["main_sha"],
        "profile_id": authority["profile_id"],
        "snapshot_bytes": authority["snapshot_bytes"],
        "snapshot_sha256": authority["snapshot_sha256"],
        "spool_basename": contract.spool_basename(authority),
    }
    if manifest != expected:
        raise ContractError("Bound spool manifest transaction mismatch.")


def safe_unlink(path: str) -> None:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def import_snapshot_to_staging(authority: dict[str, Any], paths: dict[str, str]) -> None:
    require_schema_absent(paths["staging_db"])
    root_sql(f"CREATE DATABASE {quote_identifier(paths['staging_db'])} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
    with open(paths["snapshot"], "rb") as source:
        result = subprocess.run(
            [MARIADB_BIN, "--protocol=socket", "--local-infile=0", f"--database={paths['staging_db']}"],
            stdin=source,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            env=CLEAN_ENV,
        )
    if result.returncode != 0:
        raise ContractError("Root-owned bound-spool import failed.")


def move_staging_to_candidate(paths: dict[str, str], tables: list[str]) -> None:
    require_schema_absent(paths["candidate_db"])
    root_sql(f"CREATE DATABASE {quote_identifier(paths['candidate_db'])} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
    pairs = [
        f"{quote_identifier(paths['staging_db'])}.{quote_identifier(table)} TO {quote_identifier(paths['candidate_db'])}.{quote_identifier(table)}"
        for table in tables
    ]
    root_sql("RENAME TABLE " + ",".join(pairs))
    root_sql(f"DROP DATABASE {quote_identifier(paths['staging_db'])}")


def write_candidate_seal(authority: dict[str, Any], paths: dict[str, str], tables: list[str], sanitizer_evidence: dict[str, str], hardening: dict[str, str]) -> None:
    require_fixed_dir(CANDIDATE_DIR, 0o700)
    table_digest = hashlib.sha256("\n".join(tables).encode()).hexdigest()
    payload = {
        "schema_version": 2,
        "authority_id": authority["authority_id"],
        "successor_issue": authority["successor_issue"],
        "request_id_sha256": hashlib.sha256(authority["request_id"].encode()).hexdigest(),
        "main_sha": authority["main_sha"],
        "candidate_db_sha256": hashlib.sha256(paths["candidate_db"].encode()).hexdigest(),
        "candidate_state": "SEALED_SANITIZED_HARDENED_ASSERTED",
        "canonical_policy": "agency-preprod-refresh-v1",
        "canonical_policy_sha256": POLICY_SHA256,
        "canonical_sanitizer_sha256": SANITIZER_SHA256,
        "sanitized_state_sha256": sanitizer_evidence.get("sanitized_state_sha256", ""),
        "hardening_profile_sha256": hardening.get("hardening_profile_sha256", ""),
        "base_table_count": len(tables),
        "base_table_set_sha256": table_digest,
        "runtime_database": RUNTIME_DB,
        "runtime_reachable_before_activation": False,
        "generic_candidate_credential": "NONE",
    }
    write_json_exclusive(paths["seal"], payload)


def require_candidate_seal(authority: dict[str, Any], paths: dict[str, str]) -> dict[str, Any]:
    require_fixed_file(paths["seal"], None, 0o600)
    try:
        seal = json.loads(Path(paths["seal"]).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ContractError("Candidate seal invalid.") from exc
    if seal.get("authority_id") != authority["authority_id"] or seal.get("main_sha") != authority["main_sha"]:
        raise ContractError("Candidate seal transaction binding mismatch.")
    if seal.get("candidate_state") != "SEALED_SANITIZED_HARDENED_ASSERTED":
        raise ContractError("Candidate is not sealed/hardened.")
    if seal.get("runtime_database") != RUNTIME_DB or seal.get("runtime_reachable_before_activation") is not False:
        raise ContractError("Candidate runtime-isolation seal invalid.")
    return seal


def action_import(contract: ModuleType, authority: dict[str, Any]) -> None:
    paths = derived_paths(contract, authority)
    require_bound_spool(contract, authority, paths)
    state_digest = load_refresh_modules()[1]
    runtime_before = state_digest.runtime_state_sha256()
    release_before = application_release_identity_sha256()
    authority = update_active(contract, authority, state=contract.STATE_IN_PROGRESS, phase=contract.PHASE_IMPORTING)
    sanitizer, policy = load_canonical_sanitizer()
    hardening, _ = load_refresh_modules()
    failure: BaseException | None = None
    try:
        import_snapshot_to_staging(authority, paths)
        execution = sanitizer.sanitize(paths["staging_db"], policy)
        pre = sanitizer.assert_sanitized(paths["staging_db"], execution)
        binding = hardening.harden_candidate(paths["staging_db"], sanitizer, pre)
        hardening.assert_candidate_hardened(paths["staging_db"], sanitizer, pre)
        evidence = sanitizer.assert_sanitized(paths["staging_db"], execution)
        tables = base_tables(paths["staging_db"])
        move_staging_to_candidate(paths, tables)
        write_candidate_seal(authority, paths, tables, evidence, binding)
        safe_unlink(paths["snapshot"])
        safe_unlink(paths["manifest"])
        if state_digest.runtime_state_sha256() != runtime_before or application_release_identity_sha256() != release_before:
            raise ContractError("Candidate import changed runtime or application release.")
        update_active(contract, authority, phase=contract.PHASE_CANDIDATE_SEALED)
        print("CANDIDATE_SANITIZED_HARDENED_SEALED=PASS")
        print("RAW_SNAPSHOT_TERMINAL_CLEANUP=PASS")
    except BaseException as exc:
        failure = exc
    finally:
        safe_unlink(paths["snapshot"])
        safe_unlink(paths["manifest"])
        if schema_exists(paths["staging_db"]):
            root_sql(f"DROP DATABASE {quote_identifier(paths['staging_db'])}")
    if failure is not None:
        try:
            if state_digest.runtime_state_sha256() != runtime_before or application_release_identity_sha256() != release_before:
                raise ContractError("Pre-swap failure runtime proof failed.")
            cleanup_transaction_databases(paths)
            safe_unlink(paths["seal"])
            terminalize(contract, authority, contract.STATE_ROLLED_BACK)
        except Exception as recovery_exc:
            failed = update_active(contract, authority, state=contract.STATE_FAILED_RECOVERY, phase=contract.PHASE_TERMINAL, terminal=True, human_recovery_required=True)
            record_recovery_metadata(failed, paths, "IMPORT_PRE_SWAP_PROOF_FAILED")
            print("HUMAN_RECOVERY_REQUIRED=true", file=sys.stderr)
            raise ContractError("Candidate import failed and unchanged-runtime proof failed.") from recovery_exc
        raise ContractError("Candidate lifecycle failed closed; runtime unchanged proven.") from failure


def application_release_identity_sha256() -> str:
    if not os.path.islink(CURRENT_LINK):
        raise ContractError("Current release symlink missing.")
    target = os.path.realpath(CURRENT_LINK)
    if not target.startswith(PROJECT_ROOT + "/releases/"):
        raise ContractError("Current release target outside immutable release root.")
    return hashlib.sha256(target.encode("utf-8")).hexdigest()


def close_fence() -> None:
    require_fixed_dir(STATE_DIR, 0o711)
    if os.path.lexists(FENCE_MARKER):
        raise ContractError("Fence marker already present.")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(FENCE_MARKER, flags, 0o600)
    try:
        os.write(fd, b"closed\n")
        os.fsync(fd)
    finally:
        os.close(fd)
    require_fixed_file(FENCE_MARKER, None, 0o600)


def require_fence_closed() -> None:
    require_fixed_file(FENCE_MARKER, None, 0o600)


def open_fence_after_terminal_proof() -> None:
    require_fence_closed()
    os.unlink(FENCE_MARKER)


def acquire_lock(path: str, create: bool) -> BinaryIO:
    flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    if create:
        flags |= os.O_CREAT
    fd = os.open(path, flags, 0o600)
    stream = os.fdopen(fd, "r+b", buffering=0)
    try:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        stream.close()
        raise ContractError("Concurrent deploy/refresh transaction collision.") from exc
    return stream


def drain_runtime_sessions() -> None:
    dbhex = RUNTIME_DB.encode().hex()
    ids = root_sql(
        "SELECT ID FROM information_schema.PROCESSLIST "
        "WHERE DB=CONVERT(0x%s USING utf8mb4) AND ID<>CONNECTION_ID() ORDER BY ID" % dbhex
    )
    for raw in [line for line in ids.splitlines() if line]:
        if not re.fullmatch(r"[0-9]+", raw):
            raise ContractError("Runtime session identity invalid.")
        root_sql("KILL " + raw)
    remaining = root_sql(
        "SELECT COUNT(*) FROM information_schema.PROCESSLIST "
        "WHERE DB=CONVERT(0x%s USING utf8mb4) AND ID<>CONNECTION_ID()" % dbhex
    )
    if remaining != "0":
        raise ContractError("Runtime database sessions did not drain.")


def atomic_swap(paths: dict[str, str], candidate_tables: list[str], runtime_tables: list[str]) -> None:
    if candidate_tables != runtime_tables:
        raise ContractError("Runtime/candidate table sets are incompatible.")
    require_schema_absent(paths["rollback_db"])
    root_sql(f"CREATE DATABASE {quote_identifier(paths['rollback_db'])} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
    pairs: list[str] = []
    for table in runtime_tables:
        pairs.append(f"{quote_identifier(RUNTIME_DB)}.{quote_identifier(table)} TO {quote_identifier(paths['rollback_db'])}.{quote_identifier(table)}")
        pairs.append(f"{quote_identifier(paths['candidate_db'])}.{quote_identifier(table)} TO {quote_identifier(RUNTIME_DB)}.{quote_identifier(table)}")
    root_sql("RENAME TABLE " + ",".join(pairs))


def reverse_atomic_swap(paths: dict[str, str]) -> None:
    runtime_tables = base_tables(RUNTIME_DB)
    previous_tables = base_tables(paths["rollback_db"])
    if runtime_tables != previous_tables:
        raise ContractError("Reverse-swap table sets incompatible.")
    # Candidate namespace exists and is empty after the forward swap.
    if not schema_exists(paths["candidate_db"]):
        raise ContractError("Candidate namespace missing for reverse swap.")
    pairs: list[str] = []
    for table in runtime_tables:
        pairs.append(f"{quote_identifier(RUNTIME_DB)}.{quote_identifier(table)} TO {quote_identifier(paths['candidate_db'])}.{quote_identifier(table)}")
        pairs.append(f"{quote_identifier(paths['rollback_db'])}.{quote_identifier(table)} TO {quote_identifier(RUNTIME_DB)}.{quote_identifier(table)}")
    root_sql("RENAME TABLE " + ",".join(pairs))


def run_fixed_drupal_convergence(contract: ModuleType, authority: dict[str, Any]) -> dict[str, Any]:
    current = os.path.realpath(CURRENT_LINK)
    drush = current + "/vendor/bin/drush"
    if not os.path.isfile(drush) or not os.access(drush, os.X_OK):
        raise ContractError("Fixed Drush executable unavailable.")
    authority = update_active(contract, authority, phase=contract.PHASE_CONVERGENCE_STARTED)
    commands = (
        ("updatedb", "-y"),
        ("config:import", "-y"),
    )
    for command in commands:
        result = subprocess.run([drush, *command], cwd=current, env=CLEAN_ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if result.returncode != 0:
            raise ContractError("Fixed Drupal convergence step failed.")
    split = current + "/config/splits/preproduction"
    if not os.path.isdir(split):
        raise ContractError("PREPROD config split directory unavailable.")
    result = subprocess.run([drush, "config:import", f"--source={split}", "--partial", "-y"], cwd=current, env=CLEAN_ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if result.returncode != 0:
        raise ContractError("Fixed PREPROD split import failed.")

    require_fixed_file(ADMIN_RECONCILE_PATH, ADMIN_RECONCILE_SHA256, 0o755)
    require_fixed_file(ADMIN_RECONCILE_PHP, ADMIN_RECONCILE_PHP_SHA256, 0o644)
    result = subprocess.run([ADMIN_RECONCILE_PATH], cwd=current, env=CLEAN_ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if result.returncode != 0:
        raise ContractError("Fixed PREPROD admin reconciliation failed.")

    for command in (
        ("emerging:governed-content:validate",),
        ("emerging:governed-content", "--all", "--dry-run"),
        ("cache:rebuild",),
    ):
        result = subprocess.run([drush, *command], cwd=current, env=CLEAN_ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if result.returncode != 0:
            raise ContractError("Fixed post-activation Drupal validation/convergence failed.")
    # Governed-content APPLY is intentionally absent.
    return authority


