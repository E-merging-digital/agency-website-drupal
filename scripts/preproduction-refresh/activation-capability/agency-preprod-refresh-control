def record_recovery_metadata(authority: dict[str, Any], paths: dict[str, str], reason: str) -> None:
    require_fixed_dir(RECOVERY_DIR, 0o700)
    payload = {
        "schema_version": 1,
        "authority_id": authority["authority_id"],
        "successor_issue": authority["successor_issue"],
        "main_sha": authority["main_sha"],
        "phase": authority["phase"],
        "state": authority["state"],
        "preactivation_runtime_sha256": authority.get("preactivation_runtime_sha256"),
        "application_release_sha256": authority.get("application_release_sha256"),
        "backup_sha256": authority.get("backup_sha256"),
        "backup_bytes": authority.get("backup_bytes"),
        "backup_basename": os.path.basename(paths["backup"]),
        "failure_class": reason,
        "fence": "CLOSED",
        "human_recovery_required": True,
    }
    if os.path.lexists(paths["recovery"]):
        atomic_json_replace(paths["recovery"], payload)
    else:
