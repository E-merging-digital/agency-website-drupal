#!/usr/bin/python3 -I
"""Fixed root-owned binary snapshot ingress for Agency PREPROD refresh (#915).

Framing: one UTF-8 JSON header line (<=4096 bytes), then exactly the authorized
raw snapshot bytes, then EOF.  The caller never supplies a path or filename.
"""
from __future__ import annotations

import fcntl
import hashlib
import importlib.util
import json
import os
import stat
import sys
from pathlib import Path
from types import ModuleType

CONTRACT_PATH = "/usr/local/lib/agency-preprod-refresh/transaction_contract.py"
CONTRACT_SHA256 = "47b576faccde9903371828c6cc54564ea25838fd0f37547da3e7b3c2a3b78a90"
STATE_DIR = "/var/lib/agency-preprod-refresh"
AUTHORITY_DIR = STATE_DIR + "/authority"
INCOMING_DIR = STATE_DIR + "/incoming"
ACTIVE_AUTHORITY = AUTHORITY_DIR + "/active.json"
AUTHORITY_LOCK = "/run/lock/agency-preprod-refresh-authority.lock"
HEADER_MAX = 4096
CHUNK = 1024 * 1024

class IngressError(RuntimeError):
    pass


def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(CHUNK), b""):
            digest.update(chunk)
    return digest.hexdigest()


def require_file(path: str, mode: int) -> os.stat_result:
    meta = os.lstat(path)
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISREG(meta.st_mode) or meta.st_nlink != 1:
        raise IngressError("Regular single-link file contract invalid.")
    if meta.st_uid != 0 or meta.st_gid != 0 or stat.S_IMODE(meta.st_mode) != mode:
        raise IngressError("Root ownership/mode contract invalid.")
    return meta


def require_dir(path: str, mode: int) -> None:
    meta = os.lstat(path)
    if stat.S_ISLNK(meta.st_mode) or not stat.S_ISDIR(meta.st_mode):
        raise IngressError("Fixed directory type invalid.")
    if meta.st_uid != 0 or meta.st_gid != 0 or stat.S_IMODE(meta.st_mode) != mode:
        raise IngressError("Fixed directory ownership/mode invalid.")


def load_contract() -> ModuleType:
    meta = require_file(CONTRACT_PATH, 0o644)
    if sha256_file(CONTRACT_PATH) != CONTRACT_SHA256:
        raise IngressError("Pinned transaction contract digest mismatch.")
    spec = importlib.util.spec_from_file_location("agency_preprod_transaction_contract", CONTRACT_PATH)
    if spec is None or spec.loader is None:
        raise IngressError("Pinned transaction contract loader unavailable.")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def load_active(contract: ModuleType) -> dict:
    require_file(ACTIVE_AUTHORITY, 0o600)
    try:
        value = json.loads(Path(ACTIVE_AUTHORITY).read_text(encoding="utf-8"))
        return contract.validate_authority_state(value)
    except Exception as exc:
        raise IngressError("Active transaction authority is invalid/corrupt.") from exc


def atomic_json_replace(path: str, value: dict) -> None:
    parent = os.path.dirname(path)
    tmp = parent + "/.state." + str(os.getpid()) + ".tmp"
    raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, 0o600)
    try:
        os.write(fd, raw)
        os.fsync(fd)
    finally:
        os.close(fd)
    require_file(tmp, 0o600)
    os.replace(tmp, path)
    dirfd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)
    require_file(path, 0o600)


def acquire_lock():
    fd = os.open(AUTHORITY_LOCK, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    stream = os.fdopen(fd, "r+b", buffering=0)
    try:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        stream.close()
        raise IngressError("Concurrent transaction/ingress collision.") from exc
    meta = os.fstat(stream.fileno())
    if meta.st_uid != 0 or meta.st_gid != 0 or stat.S_IMODE(meta.st_mode) != 0o600:
        stream.close()
        raise IngressError("Authority lock ownership/mode invalid.")
    return stream


def read_header() -> dict:
    raw = sys.stdin.buffer.readline(HEADER_MAX + 2)
    if not raw.endswith(b"\n") or len(raw) > HEADER_MAX + 1:
        raise IngressError("Ingress header framing invalid.")
    try:
        value = json.loads(raw[:-1].decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise IngressError("Ingress header JSON invalid.") from exc
    return value


def safe_unlink(path: str) -> None:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


def ingest(contract: ModuleType, authority: dict, header: dict) -> tuple[str, str]:
    contract.validate_ingress_binding(authority, header)
    parsed = contract.parse_ingress_header(header)
    basename = contract.spool_basename(authority)
    manifest_name = contract.manifest_basename(authority)
    final_path = INCOMING_DIR + "/" + basename
    manifest_path = INCOMING_DIR + "/" + manifest_name
    temp_path = INCOMING_DIR + "/." + authority["authority_id"] + ".partial"
    temp_manifest = INCOMING_DIR + "/." + authority["authority_id"] + ".manifest.tmp"
    for path in (final_path, manifest_path, temp_path, temp_manifest):
        if os.path.lexists(path):
            raise IngressError("Ingress target/partial collision refused.")

    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    digest = hashlib.sha256()
    remaining = parsed["expected_bytes"]
    fd = None
    try:
        fd = os.open(temp_path, flags, 0o600)
        while remaining:
            chunk = sys.stdin.buffer.read(min(CHUNK, remaining))
            if not chunk:
                raise IngressError("Partial ingress: premature EOF.")
            os.write(fd, chunk)
            digest.update(chunk)
            remaining -= len(chunk)
        extra = sys.stdin.buffer.read(1)
        if extra:
            raise IngressError("Ingress contains bytes beyond authorized length.")
        os.fsync(fd)
        os.close(fd)
        fd = None
        meta = require_file(temp_path, 0o600)
        if meta.st_size != parsed["expected_bytes"]:
            raise IngressError("Ingress byte-count verification failed.")
        actual_sha = digest.hexdigest()
        if actual_sha != parsed["expected_sha256"]:
            raise IngressError("Ingress SHA-256 verification failed.")
        if sha256_file(temp_path) != actual_sha:
            raise IngressError("Ingress on-disk SHA-256 verification failed.")

        manifest = {
            "schema_version": 1,
            "authority_id": authority["authority_id"],
            "successor_issue": authority["successor_issue"],
            "request_id": authority["request_id"],
            "main_sha": authority["main_sha"],
            "profile_id": authority["profile_id"],
            "snapshot_bytes": parsed["expected_bytes"],
            "snapshot_sha256": actual_sha,
            "spool_basename": basename,
        }
        raw_manifest = (json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
        mfd = os.open(temp_manifest, flags, 0o600)
        try:
            os.write(mfd, raw_manifest)
            os.fsync(mfd)
        finally:
            os.close(mfd)
        require_file(temp_manifest, 0o600)

        # Both destination names are internally derived and root-only.  Rename
        # finalizes the verified objects atomically within the same directory.
        os.rename(temp_path, final_path)
        os.rename(temp_manifest, manifest_path)
        require_file(final_path, 0o600)
        require_file(manifest_path, 0o600)

        updated = dict(authority)
        updated["phase"] = contract.PHASE_SNAPSHOT_READY
        atomic_json_replace(ACTIVE_AUTHORITY, updated)
        return final_path, manifest_path
    except BaseException:
        if fd is not None:
            os.close(fd)
        safe_unlink(temp_path)
        safe_unlink(temp_manifest)
        # If authority update failed after finalization, fail closed and remove
        # raw material rather than leave an unbound spool object.
        try:
            active_now = load_active(contract)
            if active_now.get("phase") != contract.PHASE_SNAPSHOT_READY:
                safe_unlink(final_path)
                safe_unlink(manifest_path)
        except Exception:
            safe_unlink(final_path)
            safe_unlink(manifest_path)
        raise


def main() -> int:
    if os.geteuid() != 0:
        raise IngressError("Binary ingress must execute as root.")
    if len(sys.argv) != 1:
        raise IngressError("Binary ingress accepts no arguments and no caller path.")
    require_dir(STATE_DIR, 0o711)
    require_dir(AUTHORITY_DIR, 0o700)
    require_dir(INCOMING_DIR, 0o700)
    contract = load_contract()
    lock = acquire_lock()
    try:
        authority = load_active(contract)
        header = read_header()
        ingest(contract, authority, header)
    finally:
        lock.close()
    print("FIXED_BINARY_INGRESS=PASS")
    print("CALLER_PATH=IMPOSSIBLE")
    print("RAW_DATA_LOG_BOUNDARY=NONE")
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (IngressError, OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(80)
