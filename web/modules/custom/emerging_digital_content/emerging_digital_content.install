<?php

/**
 * @file
 * Install hooks for Emerging Digital Content module.
 */

declare(strict_types=1);

use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_schema().
 */
function emerging_digital_content_schema(): array {
  return [
    'emerging_digital_content_sync_mapping' => _emerging_digital_content_sync_mapping_schema(),
  ];
}

/**
 * Sets front page and purges stale packaged UUIDs before auto-import runs.
 */
function emerging_digital_content_install(): void {
  _emerging_digital_content_initialize_queue_storage();
  _emerging_digital_content_purge_stale_entities();

  \Drupal::configFactory()->getEditable('system.site')
    ->set('page.front', '/')
    ->save(TRUE);

  \Drupal::state()->set('system.maintenance_mode', 0);
}

/**
 * Initializes shared queue storage before entity delete hooks can query it.
 */
function _emerging_digital_content_initialize_queue_storage(): void {
  $queue = \Drupal::queue('emerging_digital_content_install_bootstrap');
  $item_id = $queue->createItem([
    'source' => 'emerging_digital_content_install',
  ]);

  if ($item_id === FALSE) {
    throw new \RuntimeException('Unable to initialize Drupal queue storage.');
  }

  $queue->deleteQueue();
}

/**
 * Installs the Content Sync mapping table on existing environments.
 */
function emerging_digital_content_update_11001(array &$sandbox): string {
  unset($sandbox);

  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('emerging_digital_content_sync_mapping')) {
    $schema->createTable(
      'emerging_digital_content_sync_mapping',
      _emerging_digital_content_sync_mapping_schema(),
    );

    return 'Content Sync mapping table has been created.';
  }

  return 'Content Sync mapping table already exists.';
}

/**
 * Adds Blog to the main navigation without rewriting unrelated links.
 */
function emerging_digital_content_update_11002(array &$sandbox): string {
  unset($sandbox);

  $changed = _emerging_digital_content_ensure_blog_navigation_position();

  return sprintf('%d main navigation values were created or updated for Blog.', $changed);
}

/**
 * Normalizes Blog and Contact weights relative to the existing navigation.
 */
function emerging_digital_content_update_11003(array &$sandbox): string {
  unset($sandbox);

  $changed = _emerging_digital_content_ensure_blog_navigation_position();

  return sprintf('%d Blog navigation values were normalized.', $changed);
}

/**
 * Materializes the initial bilingual Blog categories on existing sites.
 */
function emerging_digital_content_update_11004(array &$sandbox): string {
  unset($sandbox);

  $result = _emerging_digital_content_ensure_initial_blog_categories();

  return sprintf(
    'Initial Blog categories ensured: %d created, %d updated.',
    $result['created'],
    $result['updated'],
  );
}

/**
 * Ensures the five editorial Blog categories defined by issue #397.
 *
 * @return array{created: int, updated: int}
 *   Counts of created and updated taxonomy terms.
 */
function _emerging_digital_content_ensure_initial_blog_categories(): array {
  $vocabulary = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_vocabulary')
    ->load('blog_categories');
  if ($vocabulary === NULL) {
    throw new \RuntimeException('Required blog_categories vocabulary does not exist.');
  }

  $manifest = [
    'd4390eaa-6097-4aee-89f8-eeed57401508' => [
      'fr' => 'Décisions web / agence senior',
      'en' => 'Web decisions / senior agency',
      'weight' => 0,
    ],
    'e7610b1c-2723-491e-837f-b0eff435f507' => [
      'fr' => 'PHP / architecture / frameworks',
      'en' => 'PHP / architecture / frameworks',
      'weight' => 1,
    ],
    '5d072809-6653-42a5-a404-bb6bb18a465e' => [
      'fr' => 'Drupal comme expertise forte',
      'en' => 'Drupal expertise',
      'weight' => 2,
    ],
    'fc8248c8-015b-4215-9354-ef554a16416d' => [
      'fr' => 'IA encadrée',
      'en' => 'Governed AI',
      'weight' => 3,
    ],
    'f2f77a08-e528-4ac7-9d78-24464bc99f21' => [
      'fr' => 'Qualité web / SEO / accessibilité',
      'en' => 'Web quality / SEO / accessibility',
      'weight' => 4,
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $created = 0;
  $updated = 0;

  foreach ($manifest as $uuid => $definition) {
    $uuid_matches = array_values($storage->loadByProperties(['uuid' => $uuid]));
    if (count($uuid_matches) > 1) {
      throw new \RuntimeException(sprintf(
        'Multiple taxonomy terms use packaged Blog category UUID %s.',
        $uuid,
      ));
    }

    $term = $uuid_matches[0] ?? NULL;
    if ($term instanceof TermInterface && $term->bundle() !== 'blog_categories') {
      throw new \RuntimeException(sprintf(
        'Packaged Blog category UUID %s already belongs to vocabulary %s.',
        $uuid,
        $term->bundle(),
      ));
    }

    if (!$term instanceof TermInterface) {
      $ids = $storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('vid', 'blog_categories')
        ->condition('langcode', 'fr')
        ->condition('name', $definition['fr'])
        ->execute();

      if (count($ids) > 1) {
        throw new \RuntimeException(sprintf(
          'Multiple Blog categories already use the FR label "%s".',
          $definition['fr'],
        ));
      }

      if ($ids !== []) {
        $term = $storage->load((int) reset($ids));
      }
    }

    $is_new = !$term instanceof TermInterface;
    if ($is_new) {
      $term = $storage->create([
        'vid' => 'blog_categories',
        'uuid' => $uuid,
        'langcode' => 'fr',
        'name' => $definition['fr'],
        'weight' => $definition['weight'],
        'status' => TRUE,
      ]);
    }

    if ($term->bundle() !== 'blog_categories') {
      throw new \RuntimeException(sprintf(
        'Blog category "%s" resolved outside blog_categories.',
        $definition['fr'],
      ));
    }
    if ($term->language()->getId() !== 'fr') {
      throw new \RuntimeException(sprintf(
        'Blog category "%s" does not use FR as its source language.',
        $definition['fr'],
      ));
    }

    $changed = FALSE;
    if ((string) $term->label() !== $definition['fr']) {
      $term->set('name', $definition['fr']);
      $changed = TRUE;
    }
    if ((int) $term->get('weight')->value !== $definition['weight']) {
      $term->set('weight', $definition['weight']);
      $changed = TRUE;
    }
    if (!(bool) $term->get('status')->value) {
      $term->set('status', TRUE);
      $changed = TRUE;
    }

    if ($term->hasTranslation('en')) {
      $translation = $term->getTranslation('en');
      if ((string) $translation->label() !== $definition['en']) {
        $translation->set('name', $definition['en']);
        $changed = TRUE;
      }
      if (!(bool) $translation->get('status')->value) {
        $translation->set('status', TRUE);
        $changed = TRUE;
      }
    }
    else {
      $term->addTranslation('en', [
        'name' => $definition['en'],
        'status' => TRUE,
      ]);
      $changed = TRUE;
    }

    if ($is_new || $changed) {
      $term->save();
      if ($is_new) {
        $created++;
      }
      else {
        $updated++;
      }
    }
  }

  return [
    'created' => $created,
    'updated' => $updated,
  ];
}
/**
 * Ensures Blog immediately precedes Contact without reweighting other links.
 */
function _emerging_digital_content_ensure_blog_navigation_position(): int {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $all_ids = \Drupal::entityQuery('menu_link_content')
    ->accessCheck(FALSE)
    ->condition('menu_name', 'main')
    ->execute();
  $all_links = $storage->loadMultiple($all_ids);

  $max_other_weight = NULL;
  foreach ($all_links as $link) {
    $title = (string) $link->label();
    if (in_array($title, ['Blog', 'Contact'], TRUE)) {
      continue;
    }

    $weight = (int) $link->get('weight')->value;
    $max_other_weight = $max_other_weight === NULL
      ? $weight
      : max($max_other_weight, $weight);
  }

  $blog_weight = ($max_other_weight ?? -1) + 1;
  $contact_weight = $blog_weight + 1;
  $changed = 0;

  $blog_ids = \Drupal::entityQuery('menu_link_content')
    ->accessCheck(FALSE)
    ->condition('menu_name', 'main')
    ->condition('title', 'Blog')
    ->execute();

  if ($blog_ids) {
    $blogs = array_values($storage->loadMultiple($blog_ids));
    $blog = array_shift($blogs);

    if ($blog instanceof MenuLinkContent) {
      $link_item = $blog->get('link')->first();
      $uri = $link_item ? ($link_item->getValue()['uri'] ?? '') : '';
      if ($uri !== 'internal:/blog') {
        $blog->set('link', ['uri' => 'internal:/blog']);
        $changed++;
      }
      if (!(bool) $blog->get('enabled')->value) {
        $blog->set('enabled', TRUE);
        $changed++;
      }
      if ((int) $blog->get('weight')->value !== $blog_weight) {
        $blog->set('weight', $blog_weight);
        $changed++;
      }
      $blog->save();
    }

    foreach ($blogs as $duplicate) {
      $duplicate->delete();
      $changed++;
    }
  }
  else {
    MenuLinkContent::create([
      'title' => 'Blog',
      'menu_name' => 'main',
      'link' => ['uri' => 'internal:/blog'],
      'expanded' => FALSE,
      'enabled' => TRUE,
      'weight' => $blog_weight,
    ])->save();
    $changed++;
  }

  $contact_ids = \Drupal::entityQuery('menu_link_content')
    ->accessCheck(FALSE)
    ->condition('menu_name', 'main')
    ->condition('title', 'Contact')
    ->execute();

  foreach ($storage->loadMultiple($contact_ids) as $contact) {
    if ((int) $contact->get('weight')->value === $contact_weight) {
      continue;
    }

    $contact->set('weight', $contact_weight);
    $contact->save();
    $changed++;
  }

  return $changed;
}

/**
 * Returns the Content Sync mapping schema definition.
 *
 * @return array<string, mixed>
 *   Drupal schema definition.
 */
function _emerging_digital_content_sync_mapping_schema(): array {
  return [
    'description' => 'Maps Content Sync business identifiers to managed Drupal entities.',
    'fields' => [
      'id' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'content_id' => [
        'description' => 'Stable business identifier declared in the Content Sync catalog.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'entity_type' => [
        'description' => 'Drupal entity type managed by Content Sync.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'entity_id' => [
        'description' => 'Drupal entity numeric identifier.',
        'type' => 'int',
        'unsigned' => TRUE,
      ],
      'entity_uuid' => [
        'description' => 'Drupal entity UUID.',
        'type' => 'varchar',
        'length' => 128,
      ],
      'langcode' => [
        'description' => 'Primary language code tracked for the mapping.',
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ],
      'catalog_hash' => [
        'description' => 'Hash of the catalog definition used during the last sync.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'last_synced' => [
        'description' => 'Unix timestamp of the latest successful sync.',
        'type' => 'int',
        'unsigned' => TRUE,
      ],
      'last_action' => [
        'description' => 'Latest Content Sync action recorded for this mapping.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'status' => [
        'description' => 'Mapping status reserved for future prune and audit workflows.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'active',
      ],
      'created' => [
        'description' => 'Unix timestamp when the mapping was created.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'description' => 'Unix timestamp when the mapping was last changed.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'content_id' => ['content_id'],
    ],
    'indexes' => [
      'entity' => ['entity_type', 'entity_id'],
      'entity_uuid' => ['entity_uuid'],
      'langcode' => ['langcode'],
      'status' => ['status'],
      'last_action' => ['last_action'],
      'last_synced' => ['last_synced'],
    ],
  ];
}

/**
 * Deletes existing packaged entities by UUID to avoid duplicate collisions.
 */
function _emerging_digital_content_purge_stale_entities(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $base = DRUPAL_ROOT . '/modules/custom/emerging_digital_content/content';

  foreach (['paragraph', 'node'] as $entity_type) {
    $files = glob($base . '/' . $entity_type . '/*.yml') ?: [];
    $storage = $entity_type_manager->getStorage($entity_type);

    foreach ($files as $file) {
      $uuid = pathinfo($file, PATHINFO_FILENAME);
      $existing = $storage->loadByProperties(['uuid' => $uuid]);
      if ($existing) {
        $storage->delete($existing);
      }
    }
  }
}
